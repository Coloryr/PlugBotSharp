<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PlugBotSharp.Core\PlugBotSharp.Core.csproj" />
  </ItemGroup>

  <!-- 组件只参与构建，dll 从打包好的 zip 里解出来，不直接引用 -->
  <ItemGroup>
    <ProjectReference Include="..\Lib\PlugBotSharp.Core.Lib\PlugBotSharp.Core.Lib.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Lib\PlugBotSharp.QQLib\PlugBotSharp.QQLib.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Lib\PlugBotSharp.OneBotLib\PlugBotSharp.OneBotLib.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Plugin\DemoPlugin\DemoPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Proxy\PlugBotSharp.QQProxy\PlugBotSharp.QQProxy.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Proxy\PlugBotSharp.OneBotProxy\PlugBotSharp.OneBotProxy.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Proxy\PlugBotSharp.GsCoreProxy\PlugBotSharp.GsCoreProxy.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- 组件包解到运行目录的 Components/{组件id} -->
  <ItemGroup>
    <DeployComponent Include="Components\core">
      <Zip>..\Lib\PlugBotSharp.Core.Lib\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.Core.Lib.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\qqlib">
      <Zip>..\Lib\PlugBotSharp.QQLib\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.QQLib.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\onebotlib">
      <Zip>..\Lib\PlugBotSharp.OneBotLib\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.OneBotLib.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\demo">
      <Zip>..\Plugin\DemoPlugin\bin\$(Configuration)\$(TargetFramework)\DemoPlugin.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\qqproxy">
      <Zip>..\Proxy\PlugBotSharp.QQProxy\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.QQProxy.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\onebotproxy">
      <Zip>..\Proxy\PlugBotSharp.OneBotProxy\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.OneBotProxy.zip</Zip>
    </DeployComponent>
    <DeployComponent Include="Components\gscoreproxy">
      <Zip>..\Proxy\PlugBotSharp.GsCoreProxy\bin\$(Configuration)\$(TargetFramework)\PlugBotSharp.GsCoreProxy.zip</Zip>
    </DeployComponent>
  </ItemGroup>

  <!--
    构建完把组件覆盖解压到输出目录，直接就能跑。
    运行目录里的 Nugets / Configs / Instances / Certs / Logs 是运行时数据，这里一个都不删，
    免得每次构建都要重新下载 NuGet 包。
  -->
  <Target Name="DeployComponents" AfterTargets="Build">
    <Error Condition="!Exists('%(DeployComponent.Zip)')" Text="组件包不存在：%(DeployComponent.Zip)，先构建组件工程" />
    <MakeDir Directories="$(OutDir)%(DeployComponent.Identity)" />
    <Unzip SourceFiles="%(DeployComponent.Zip)" DestinationFolder="$(OutDir)%(DeployComponent.Identity)" />
  </Target>

</Project>